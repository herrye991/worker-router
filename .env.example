# Worker secrets (set via `wrangler secret put <NAME>`)
# Never commit real values.

# Master key for provider credential encryption (32+ random bytes, base64).
# Generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# Initial admin password (password-only login, default 123456).
# Set via secret in production: wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=123456

# Admin session signing secret
SESSION_SECRET=

# D1 binding name must match wrangler.jsonc
# DB binding: DB
